# Copia este archivo a .env y llena los valores. .env nunca se commitea.
API_TOKEN=
OPENROUTER_API_KEY=
# Id del modelo en OpenRouter (verifica el id exacto en su lista de modelos)
MODELO_ID=
# Carpeta de capturas de la evidencia
CUADROS_DIR=capturas
# Tope de costo por tarea en dólares
COSTO_MAX_POR_TAREA=0.50
# Ruta del archivo SQLite
DB_PATH=navegante.db
# Segundos que dura el worker de mentira de B1 (0 = no espera)
WORKER_DEMORA=2
